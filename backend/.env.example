# Copy this file to .env and enter values from Supabase Project Settings.
# Never commit .env or expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
